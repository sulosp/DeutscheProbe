# DeutscheProbe environment
# Copy to .env.local. Every variable is optional: with nothing set, the app
# runs in demo mode (accounts, attempts and scores stay in this browser).

# Canonical origin for sitemap, robots and Open Graph.
# Falls back to https://deutscheprobe.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=https://deutscheprobe.vercel.app

# --- Supabase (free tier) ---------------------------------------------------
# Project URL and anon key from Project Settings → API.
# Enable Email under Authentication → Providers.
# Add the site URL and /auth/callback to the redirect allow list.
# Password reset uses /auth/callback?next=/passwort-zuruecksetzen — if the
# project matches the full redirect URL, allow that address too.
# Then run supabase/schema.sql in the SQL editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google is optional. Set to true only after Google is enabled in Supabase
# and on Vercel. The "Mit Google fortfahren" button stays hidden otherwise.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=

# Server-only. Needed to delete an account (auth user plus their rows).
# Project Settings → API → service_role. Never expose this in the browser.
# Without it, account deletion returns a clear error and keeps the account.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (free tier) for Schreiben / Sprechen feedback -------------------
# Without a key, feedback uses the built-in mock examiner.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
