# DeutscheProbe environment
# Copy to .env.local. Every variable is optional: with nothing set, the app
# runs in demo mode (accounts, attempts and scores stay in this browser).

# Canonical origin for sitemap, robots and Open Graph.
# Falls back to https://deutscheprobe.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=https://deutscheprobe.vercel.app

# --- Supabase (free tier) ---------------------------------------------------
# Project URL and anon key from Project Settings → API.
# Enable Email and Google under Authentication → Providers.
# Add the site URL and /auth/callback to the redirect allow list.
# Then run supabase/schema.sql in the SQL editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Gemini (free tier) for Schreiben / Sprechen feedback -------------------
# Without a key, feedback uses the built-in mock examiner.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
